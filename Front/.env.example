# IMPORTANT: do NOT commit a real .env file. .env is git-ignored.
# Copy this file to `Front/.env` and adjust values for your local setup.

# --- VITE_* variables are inlined into the browser bundle at build time ---
# Any credential placed under VITE_* ships to every client. Never put
# database passwords, API secrets, or session cookies here.
#
# The legacy VITE_DB_* block was removed in PR split/pr-1-restructure
# because VITE_DB_PASSWORD=changeme (or anything stronger) would have
# leaked to every browser. Server-side DB credentials now live in
# docker-compose.yml (read only by the db service) and in Back/.env
# (read by the Fastify service starting in PR 2).

# Base URL for the Fastify backend. Empty (same-origin) when the frontend
# is served through the nginx / Vite proxy. Set this only when the
# frontend talks to a backend on a different origin (e.g. a deployed
# staging environment where the API is on api.example.com).
# VITE_API_BASE=http://localhost:3000

# --- docker-compose.yml reads these server-side (NOT Vite, NOT the browser) ---
# These match the defaults baked into docker-compose.yml; you only need
# to set them in a local .env if you want to override the defaults.
# Change POSTGRES_PASSWORD before any non-toy use.
POSTGRES_USER=finances_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=finances_db