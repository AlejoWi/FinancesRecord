# Files excluded from the Back/ Docker build context.
# Keeps the image small and prevents leaking secrets or local-only files.

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local env / secrets
.env
.env.*
!.env.example

# VCS / IDE
.git
.gitignore
.gitattributes
.github
.vscode
.idea
.husky
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project-specific
.atl
*.log
coverage
tests
README.md
