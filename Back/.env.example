# Server-only environment variables for the Back/ service.
# Copy to .env and fill in real values; .env is gitignored.
# Loaded by `dotenv` on server start; validated by Back/src/config.js (zod).

# PostgreSQL connection string used by the pg pool.
# In docker-compose the backend reaches the `db` service by name.
DATABASE_URL=postgres://finances_user:changeme@db:5432/finances_db

# HTTP port the Fastify server binds to.
PORT=3000

# Runtime mode. Drives logging, cookie Secure flag, and required-env checks.
# Allowed: development | test | production
NODE_ENV=development

# Secret used to sign session cookies (wired in PR 3).
# Required when NODE_ENV=production. Generate with:
#   node -e "console.log(crypto.randomBytes(48).toString('base64'))"
COOKIE_SECRET=replace-me-with-a-long-random-string
