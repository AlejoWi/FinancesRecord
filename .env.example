# IMPORTANT: do NOT commit a real .env file. .env is git-ignored.
# Copy this file to `.env` and adjust values for your local setup.

# These variables describe the intended backend PostgreSQL instance.
# NOTE: The current frontend does NOT connect directly to PostgreSQL.
# Exposing DB credentials to the browser (VITE_* prefix) would leak them
# to every client. These vars are kept here for future backend/API use.
VITE_DB_HOST=localhost
VITE_DB_PORT=5432
VITE_DB_NAME=finances_db
VITE_DB_USER=finances_user
VITE_DB_PASSWORD=changeme

# PostgreSQL (used by docker-compose.yml for the db service).
# These match the defaults baked into docker-compose.yml; you only need
# to set them in a local .env if you want to override the defaults.
# Change POSTGRES_PASSWORD before any non-toy use.
POSTGRES_USER=finances_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=finances_db
